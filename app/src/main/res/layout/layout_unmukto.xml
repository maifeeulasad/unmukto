<?xml version="1.0" encoding="utf-8"?>
<!--
    No horizontal padding anywhere in here: Keyboard sizes its keys against the display
    width, not the view width, so any side padding would push the last column off the edge.
    Spacing between keys is drawn as an inset by UnmuktoKeyboardView instead.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/keyboard_background"
    android:paddingTop="6dp"
    android:paddingBottom="8dp">

    <com.mua.unmukto.UnmuktoKeyboardView
        android:id="@+id/ukv_main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:keyBackground="@android:color/transparent"
        android:keyPreviewLayout="@layout/key_preview"
        android:keyPreviewOffset="-8dp"
        android:keyPreviewHeight="64dp"
        android:shadowColor="@android:color/transparent"
        android:shadowRadius="0"/>

    <!--
        The emoji panel replaces the keyboard rather than sitting beside it: only one of
        the two is ever visible. Kept as a sibling, and not swapped in and out, because
        rebuilding it means asking the font about a few thousand code points again.
    -->
    <com.mua.unmukto.emoji.EmojiPanelView
        android:id="@+id/emoji_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"/>

</LinearLayout>
